{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.py"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/update-prices",
      "schedule": "10 8 * * *"
    },
    {
      "path": "/api/cron/update-prices",
      "schedule": "30 9 * * *"
    }
  ]
}
